{"id": "js01", "prompt": "Extract the invoice: 'Invoice INV-2041 from ACME GmbH, 2026-07-03. 3x Widget A at 19.90 EUR, 1x Widget B at 4.50 EUR.'", "schema": {"type": "object", "properties": {"invoice_id": {"type": "string"}, "vendor": {"type": "string"}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "items": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "qty": {"type": "integer"}, "unit_price": {"type": "number"}}, "required": ["name", "qty", "unit_price"], "additionalProperties": false}}}, "required": ["invoice_id", "vendor", "date", "items"], "additionalProperties": false}, "checks": {"invoice_id": "INV-2041"}, "tags": ["nested-array"]}
{"id": "js02", "prompt": "Classify this support ticket: 'My dashboard has been loading for 10 minutes, this is blocking our whole team!!'", "schema": {"type": "object", "properties": {"category": {"type": "string", "enum": ["billing", "bug", "performance", "feature_request", "other"]}, "urgency": {"type": "string", "enum": ["low", "medium", "high"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["category", "urgency", "confidence"], "additionalProperties": false}, "tags": ["enum", "bounded-number"]}
{"id": "js03", "prompt": "Extract contact info: 'Reach Dr. José Müller-Lüdenscheid at jose.mueller@uni-berlin.de or +49 30 1234567.'", "schema": {"type": "object", "properties": {"name": {"type": "string"}, "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"}, "phone": {"type": "string"}}, "required": ["name", "email"], "additionalProperties": false}, "checks": {"email": "jose.mueller@uni-berlin.de"}, "tags": ["unicode", "pattern"]}
{"id": "js04", "prompt": "Extract shipping details: 'Ship to Anna Schmidt, Hauptstr. 5, 01099 Dresden, Germany.'", "schema": {"type": "object", "properties": {"recipient": {"type": "string"}, "street": {"type": "string"}, "postal_code": {"type": "string"}, "city": {"type": "string"}, "country": {"type": "string"}}, "required": ["recipient", "street", "postal_code", "city", "country"], "additionalProperties": false}, "checks": {"postal_code": "01099"}, "tags": ["string-vs-number-trap"]}
{"id": "js05", "prompt": "The text mentions no products at all, extract anyway: 'Thanks for the great support call yesterday!'", "schema": {"type": "object", "properties": {"products": {"type": "array", "items": {"type": "string"}}, "sentiment": {"type": "string", "enum": ["positive", "neutral", "negative"]}}, "required": ["products", "sentiment"], "additionalProperties": false}, "checks": {"products": []}, "tags": ["empty-array", "enum"]}
{"id": "js06", "prompt": "Summarize this meeting note into the schema: 'Q3 planning: Maria owns the migration (due Sept 30), Tom owns hiring (due Oct 15). Budget approved. Next sync Friday.'", "schema": {"type": "object", "properties": {"topic": {"type": "string"}, "action_items": {"type": "array", "minItems": 2, "items": {"type": "object", "properties": {"owner": {"type": "string"}, "task": {"type": "string"}, "due": {"type": ["string", "null"]}}, "required": ["owner", "task", "due"], "additionalProperties": false}}, "decisions": {"type": "array", "items": {"type": "string"}}}, "required": ["topic", "action_items", "decisions"], "additionalProperties": false}, "tags": ["nested-array", "nullable"]}
{"id": "js07", "prompt": "Rate this code review comment's tone from 1 to 5 (integer, 5 = kindest): 'This is wrong. Read the docs before pushing garbage.'", "schema": {"type": "object", "properties": {"tone_rating": {"type": "integer", "minimum": 1, "maximum": 5}, "is_constructive": {"type": "boolean"}}, "required": ["tone_rating", "is_constructive"], "additionalProperties": false}, "tags": ["integer-bound", "boolean"]}
{"id": "js08", "prompt": "Parse the log line: '2026-08-12T14:03:22Z ERROR payment-svc Connection pool exhausted (retries=3)'", "schema": {"type": "object", "properties": {"timestamp": {"type": "string"}, "level": {"type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"]}, "service": {"type": "string"}, "message": {"type": "string"}, "retries": {"type": "integer"}}, "required": ["timestamp", "level", "service", "message"], "additionalProperties": false}, "checks": {"level": "ERROR", "retries": 3}, "tags": ["extraction"]}
{"id": "js09", "prompt": "Extract the recipe: 'Grandma's pancakes: 2 cups flour, 3 eggs, a pinch of salt. Fry 5 minutes per side.' Give ingredients as strings.", "schema": {"type": "object", "properties": {"name": {"type": "string"}, "ingredients": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "steps": {"type": "array", "items": {"type": "string"}}, "vegan": {"type": "boolean"}}, "required": ["name", "ingredients", "steps", "vegan"], "additionalProperties": false}, "checks": {"vegan": false}, "tags": ["inference", "boolean"]}
{"id": "js10", "prompt": "Extract GPS: 'The wreck lies at 41 degrees 43.55 minutes north, 49 degrees 56.75 minutes west.' Return decimal degrees rounded to 4 places, west/south negative.", "schema": {"type": "object", "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}, "required": ["lat", "lon"], "additionalProperties": false}, "tags": ["arithmetic", "bounded-number"]}
{"id": "js11", "prompt": "List the EU member states mentioned: 'We operate in Germany, Switzerland, France, Norway and Spain.'", "schema": {"type": "object", "properties": {"eu_members": {"type": "array", "items": {"type": "string", "enum": ["Germany", "France", "Spain"]}}, "non_eu": {"type": "array", "items": {"type": "string"}}}, "required": ["eu_members", "non_eu"], "additionalProperties": false}, "tags": ["knowledge-filter", "enum-array"]}
{"id": "js12", "prompt": "Produce a config for a service named 'ingest' with 2 replicas, no persistence, listening on port 8080, env set to 'prod'. Use exactly these keys.", "schema": {"type": "object", "properties": {"service": {"type": "string"}, "replicas": {"type": "integer", "minimum": 1}, "persistence": {"type": "boolean"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "env": {"type": "string", "enum": ["dev", "staging", "prod"]}}, "required": ["service", "replicas", "persistence", "port", "env"], "additionalProperties": false}, "checks": {"replicas": 2, "persistence": false, "port": 8080, "env": "prod"}, "tags": ["construction", "noise-resistance"]}
